# Local Connect (LocalServices) Environment Configuration

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000
NODE_ENV="development"

# Client Base URL (for production separation)
VITE_API_BASE_URL="/api/v1"

# Production MongoDB Atlas URI (optional for hosted mongo persistence)
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/localservices?retryWrites=true&w=majority"

# Authentication & Session
JWT_SECRET="your_production_jwt_secret_key_change_in_prod"
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:3000"
